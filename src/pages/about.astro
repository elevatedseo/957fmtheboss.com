---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About | 95.7 The Boss FM" description="About 95.7 The Boss FM — the city's #1 for hip-hop and R&B, broadcasting on 95.7 FM and 1690 AM.">
  <section class="page-hero">
    <p class="kicker">The Station</p>
    <h1>About <em>The Boss</em></h1>
    <p>95.7 The Boss FM — the city's #1 for hip-hop and R&amp;B.</p>
  </section>

  <section class="section about-grid">
    <div>
      <h2>We run <em>the city.</em></h2>
      <p>95.7 The Boss FM is the home of hip-hop and R&amp;B — broadcasting live on 95.7 FM and 1690 AM, and streaming everywhere. From morning drive to the quiet storm, we keep the culture moving with the biggest records, the hottest DJs, and the mix shows the streets talk about.</p>
      <p>Shows like <strong>The Lunch Breaks with DJ Swayd</strong> and <strong>The Drive @ 5 Street Mix with DJ Ivan Alferez</strong> are appointment listening. And with our Independent Spotlight, we're putting the next generation of artists on the air — powered by Time Share Radio.</p>
    </div>
    <div class="about-facts">
      <div class="fact"><span class="fact-num">95.7</span><span class="fact-label">FM + 1690 AM</span></div>
      <div class="fact"><span class="fact-num">24/7</span><span class="fact-label">Hip-Hop &amp; R&amp;B</span></div>
      <div class="fact"><span class="fact-num">Live</span><span class="fact-label">Streaming everywhere</span></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Why <em>Listen</em></h2></div>
    <div class="cards">
      <div class="card">
        <h3>🔥 The Hottest Records</h3>
        <p>New drops, throwbacks, and exclusives — if it's moving the culture, it's on The Boss first.</p>
      </div>
      <div class="card">
        <h3>🎧 Real DJs</h3>
        <p>DJ Swayd, DJ Ivan Alferez, and more — live mixes, not algorithms.</p>
      </div>
      <div class="card">
        <h3>🎤 Independent Artists</h3>
        <p>Through Time Share Radio, indie hip-hop and R&amp;B artists get real airplay on a real station.</p>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <h2>Turn it <em>up.</em></h2>
    <p>Hit play and stay locked in — 95.7 The Boss is live right now.</p>
    <button class="btn" data-action="play">▶ Listen Live</button>
  </section>
</Layout>

<style>
  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start; }
  .about-grid h2 { font-size: clamp(34px, 5vw, 60px); }
  .about-grid h2 em { color: var(--accent); font-style: normal; }
  .about-grid p { font-size: 17px; }
  .about-grid strong { color: var(--text); }
  .about-facts { display: flex; flex-direction: column; gap: 16px; }
  .fact { background: var(--bg2); border: 1px solid var(--line); border-left: 4px solid var(--accent); padding: 24px; display: flex; flex-direction: column; gap: 4px; }
  .fact-num { font-size: 38px; font-weight: 900; color: var(--accent2); font-style: italic; }
  .fact-label { font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); font-weight: 700; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .card { background: var(--bg2); border: 1px solid var(--line); border-top: 4px solid var(--accent); padding: 28px; }
  .card h3 { font-size: 20px; text-transform: none; letter-spacing: 0; }
  .card p { font-size: 14px; margin: 0; }
  .cta-band { text-align: center; background: var(--bg2); border: 1px solid var(--line); border-top: 4px solid var(--accent); padding: 56px 32px !important; }
  .cta-band h2 { font-size: clamp(36px, 6vw, 64px); }
  .cta-band h2 em { color: var(--accent); font-style: normal; }
  @media (max-width: 820px) { .about-grid, .cards { grid-template-columns: 1fr; } }
</style>

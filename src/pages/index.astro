---
import Layout from '../layouts/Layout.astro';
import { STREAM_URL, TIME_SHARE_URL } from '../config';

const news = [
  {
    tag: 'Music News',
    date: 'September 29, 2026',
    title: "Megan Thee Stallion Drops 'Tina Tuesday Freestyle,' Books Victoria's Secret Fashion Show",
    excerpt: "Megan revived her Tina Snow alter ego over Mike Jones' \"Still Tippin'\" — and was just announced as a performer at the 2026 Victoria's Secret Fashion Show in Los Angeles on October 18.",
  },
  {
    tag: 'Awards',
    date: 'September 27, 2026',
    title: "Cardi B & Kehlani Make VMA History: 'Safe' Wins Best Hip-Hop",
    excerpt: "Their \"Safe\" collaboration took Best Hip-Hop at the 2026 MTV VMAs — the first all-female collaboration ever to win the category.",
  },
  {
    tag: 'New Music',
    date: 'September 2026',
    title: "Wiz Khalifa Drops New Single 'Yiccen' Ahead of 'Cool Azz Summer' EP",
    excerpt: "The Pittsburgh rapper put out \"Yiccen\" with Memphis-style production and announced his Cool Azz Summer EP — plus a country-rap crossover with Graham Barham on \"LEAVIN'.\"",
  },
];

const shows = [
  { time: '6:00 AM – 10:00 AM', name: 'The Morning Boss', host: 'Wake up with the biggest hip-hop and R&B records' },
  { time: '12:00 PM – 1:00 PM', name: 'The Lunch Breaks', host: 'with DJ Swayd' },
  { time: '3:00 PM – 7:00 PM', name: 'The Drive @ 5 Street Mix', host: 'with DJ Ivan Alferez' },
  { time: '8:00 PM – 12:00 AM', name: 'The Night Shift', host: 'Slow jams and late-night R&B' },
];
---
<Layout title="95.7 The Boss FM | The City's #1 for Hip-Hop and R&B">
  <!-- HERO with real logo -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-inner">
      <img src="/images/logo.png" alt="95.7 The Boss" class="hero-logo" width="400" height="400" />
      <p class="kicker"><span class="live-dot"></span> Live on 95.7 FM &amp; 1690 AM — Streaming Now</p>
      <h1 class="sr-only">95.7 The Boss FM</h1>
      <p class="hero-sub">The city's #1 for hip-hop and R&amp;B. Turn it up — we're live right now.</p>
      <div class="hero-player">
        <audio controls preload="none" src={STREAM_URL} class="hero-audio"></audio>
      </div>
      <div class="hero-actions">
        <a class="btn" href="/shows/">View Schedule</a>
        <a class="btn ghost" href="/news/">Latest News</a>
      </div>
    </div>
  </section>

  <!-- ARTIST SUBMISSIONS with PayPal -->
  <section class="section artist-cta">
    <div class="artist-cta-inner">
      <div>
        <p class="kicker">For Artists</p>
        <h2>Get Your Music <em>On The Air</em></h2>
        <p>Submit your track for rotation on 95.7 The Boss. Independent artists — this is your shot. Powered by <a href={TIME_SHARE_URL}>Time Share Radio</a>.</p>
      </div>
      <div class="artist-actions">
        <a class="btn paypal" href="https://www.paypal.com/ncp/payment/2DSWELQCG67ZG" target="_blank" rel="noopener">Submit Your Track — Pay with PayPal</a>
        <a class="btn ghost" href="https://www.paypal.com/donate/?hosted_button_id=Z6MBQ3CNHWCEE" target="_blank" rel="noopener">Support The Station</a>
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section class="section">
    <div class="section-head">
      <h2>Latest <em>News</em></h2>
      <a href="/news/">All stories →</a>
    </div>
    <div class="cards">
      {news.map(n => (
        <article class="card">
          <div class="card-top">
            <span class="card-tag">{n.tag}</span>
            <span class="card-date">{n.date}</span>
          </div>
          <h3>{n.title}</h3>
          <p>{n.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- SHOWS -->
  <section class="section">
    <div class="section-head">
      <h2>On <em>Air</em></h2>
      <a href="/shows/">Full schedule →</a>
    </div>
    <div class="schedule">
      {shows.map(s => (
        <div class="show-row">
          <span class="show-time">{s.time}</span>
          <div>
            <strong>{s.name}</strong>
            <span>{s.host}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- TIME SHARE RADIO cross-promo -->
  <section class="section tsr-band">
    <div class="tsr-inner">
      <h2>Independent Artist? <em>Get Discovered.</em></h2>
      <p>Time Share Radio gives independent artists a platform to reach real listeners. Submit your music, build your profile, sell your tracks.</p>
      <a class="btn" href={TIME_SHARE_URL}>Explore Time Share Radio →</a>
    </div>
  </section>
</Layout>
<style>
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .hero{position:relative;min-height:90vh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;background:#0a0a0a}
  .hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 30%,rgba(230,57,0,.25),transparent 60%)}
  .hero-inner{position:relative;z-index:1;max-width:800px;padding:60px 24px}
  .hero-logo{width:min(400px,70vw);height:auto;margin:0 auto 30px;display:block;filter:drop-shadow(0 10px 40px rgba(230,57,0,.4))}
  .kicker{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.15em;font-size:12px;color:#e63900;font-weight:700;margin-bottom:20px}
  .live-dot{width:10px;height:10px;border-radius:50%;background:#e63900;animation:pulse 1.5s infinite}
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}
  .hero-sub{font-size:20px;color:#aaa;max-width:500px;margin:0 auto 30px}
  .hero-player{margin:0 auto 30px;max-width:500px}
  .hero-audio{width:100%;height:54px;border-radius:8px}
  .hero-actions{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  .btn{display:inline-block;padding:16px 32px;background:#e63900;color:#fff;text-decoration:none;text-transform:uppercase;font-weight:700;letter-spacing:.08em;font-size:13px;border-radius:4px;transition:transform .2s,background .2s}
  .btn:hover{background:#ff4d1a;transform:translateY(-2px)}
  .btn.ghost{background:transparent;border:2px solid #e63900;color:#e63900}
  .btn.ghost:hover{background:#e63900;color:#fff}
  .btn.paypal{background:#0070ba}
  .btn.paypal:hover{background:#005ea6}
  .section{padding:80px 24px;max-width:1200px;margin:0 auto}
  .section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px}
  .section-head h2{font-size:clamp(36px,5vw,56px);text-transform:uppercase;margin:0}
  .section-head h2 em{color:#e63900;font-style:normal}
  .section-head a{color:#e63900;text-decoration:none;font-weight:700}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px}
  .card{background:#1a1a1a;border-radius:8px;padding:28px;border-top:3px solid #e63900}
  .card-top{display:flex;justify-content:space-between;margin-bottom:16px}
  .card-tag{background:#e63900;color:#fff;padding:4px 12px;border-radius:20px;font-size:11px;text-transform:uppercase;font-weight:700}
  .card-date{color:#666;font-size:12px}
  .card h3{font-size:20px;margin:0 0 12px;line-height:1.3}
  .card p{color:#999;font-size:14px;line-height:1.6;margin:0}
  .schedule{display:flex;flex-direction:column;gap:0;border:1px solid #222;border-radius:8px;overflow:hidden}
  .show-row{display:grid;grid-template-columns:200px 1fr;gap:24px;padding:24px 28px;background:#1a1a1a;border-bottom:1px solid #222;align-items:center}
  .show-row:last-child{border-bottom:0}
  .show-time{color:#e63900;font-weight:700;font-size:14px}
  .show-row strong{display:block;font-size:18px;margin-bottom:4px}
  .show-row span{color:#888;font-size:14px}
  .artist-cta{background:linear-gradient(135deg,#1a0a00,#0a0a0a);border:1px solid #e6390033;border-radius:12px;margin:0 24px;max-width:1152px}
  .artist-cta-inner{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:60px;align-items:center}
  .artist-cta h2{font-size:clamp(32px,4vw,48px);text-transform:uppercase;margin:0 0 16px}
  .artist-cta h2 em{color:#e63900;font-style:normal}
  .artist-cta p{color:#aaa;line-height:1.6}
  .artist-cta a:not(.btn){color:#e63900}
  .artist-actions{display:flex;flex-direction:column;gap:16px}
  .tsr-band{background:#e63900;border-radius:12px;text-align:center;margin:0 24px 80px;max-width:1152px}
  .tsr-inner{padding:60px 40px}
  .tsr-band h2{font-size:clamp(32px,4vw,48px);text-transform:uppercase;margin:0 0 16px;color:#fff}
  .tsr-band h2 em{font-style:normal;color:#0a0a0a}
  .tsr-band p{color:rgba(255,255,255,.85);max-width:600px;margin:0 auto 30px;line-height:1.6}
  .tsr-band .btn{background:#0a0a0a}
  .tsr-band .btn:hover{background:#222}
  @media(max-width:768px){
    .artist-cta-inner{grid-template-columns:1fr;padding:40px 24px}
    .show-row{grid-template-columns:1fr;gap:8px}
    .hero-logo{width:min(280px,80vw)}
  }
</style>

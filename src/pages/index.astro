---
import Layout from '../layouts/Layout.astro';
import { STREAM_URL, TIME_SHARE_URL } from '../config';

const news = [
  {
    tag: 'Music News',
    date: 'September 29, 2026',
    title: "Megan Thee Stallion Drops 'Tina Tuesday Freestyle,' Books Victoria's Secret Fashion Show",
    excerpt: "Megan revived her Tina Snow alter ego over Mike Jones' \"Still Tippin'\" — and was just announced as a performer at the 2026 Victoria's Secret Fashion Show in Los Angeles on October 18.",
  },
  {
    tag: 'Awards',
    date: 'September 27, 2026',
    title: "Cardi B & Kehlani Make VMA History: 'Safe' Wins Best Hip-Hop",
    excerpt: "Their \"Safe\" collaboration took Best Hip-Hop at the 2026 MTV VMAs — the first all-female collaboration ever to win the category.",
  },
  {
    tag: 'New Music',
    date: 'September 2026',
    title: "Wiz Khalifa Drops New Single 'Yiccen' Ahead of 'Cool Azz Summer' EP",
    excerpt: "The Pittsburgh rapper put out \"Yiccen\" with Memphis-style production and announced his Cool Azz Summer EP — plus a country-rap crossover with Graham Barham on \"LEAVIN'.\"",
  },
];

const shows = [
  { time: '6:00 AM – 10:00 AM', name: 'The Morning Boss', host: 'Wake up with the biggest hip-hop and R&B records' },
  { time: '12:00 PM – 1:00 PM', name: 'The Lunch Breaks', host: 'with DJ Swayd — presented by William King' },
  { time: '3:00 PM – 7:00 PM', name: 'The Drive @ 5 Street Mix', host: 'with DJ Ivan Alferez — presented by William King' },
  { time: '8:00 PM – 12:00 AM', name: 'The Night Shift', host: 'Slow jams and late-night R&B' },
];
---
<Layout title="95.7 The Boss FM | The City's #1 for Hip-Hop and R&B">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <p class="kicker">Live on 95.7 FM &amp; 1690 AM</p>
      <h1>95.7<br /><em>THE BOSS</em></h1>
      <p class="hero-sub">The city's #1 for hip-hop and R&amp;B. Turn it up — we're live right now.</p>
      <div class="hero-actions">
        <button class="btn" data-action="play">▶ Listen Live</button>
        <a class="btn ghost" href="/shows/">View Schedule</a>
      </div>
      <div class="hero-player">
        <audio controls preload="none" src={STREAM_URL} class="hero-audio"></audio>
        <p class="hero-player-note"><span class="live-dot"></span> Streaming live — hit play above or use the player bar below.</p>
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section class="section">
    <div class="section-head">
      <h2>Latest <em>News</em></h2>
      <a href="/news/">All stories →</a>
    </div>
    <div class="cards">
      {news.map(n => (
        <article class="card">
          <div class="card-top">
            <span class="card-tag">{n.tag}</span>
            <span class="card-date">{n.date}</span>
          </div>
          <h3>{n.title}</h3>
          <p>{n.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- SHOWS -->
  <section class="section">
    <div class="section-head">
      <h2>On <em>Air</em></h2>
      <a href="/shows/">Full schedule →</a>
    </div>
    <div class="schedule">
      {shows.map(s => (
        <div class="show-row">
          <span class="show-time">{s.time}</span>
          <div>
            <h3>{s.name}</h3>
            <p>{s.host}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- TIME SHARE RADIO CTA -->
  <section class="tsr-cta">
    <div class="tsr-inner">
      <p class="kicker">For Independent Artists</p>
      <h2>Got music? <em>Get on the air.</em></h2>
      <p>95.7 The Boss streams the same independent heat as Time Share Radio. Submit your tracks, build your artist profile, and get your moment in the spotlight.</p>
      <div class="hero-actions">
        <a class="btn" href={TIME_SHARE_URL} target="_blank" rel="noopener">Submit Your Music ↗</a>
        <a class="btn ghost" href={TIME_SHARE_URL + '/artist/'} target="_blank" rel="noopener">Explore Artists</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background:
      radial-gradient(circle at 80% 20%, rgba(230,57,0,.35), transparent 45%),
      linear-gradient(160deg, #1a1a1a 0%, #111111 60%);
    border-bottom: 2px solid var(--accent);
    padding: clamp(64px, 10vw, 130px) clamp(16px, 4vw, 48px);
  }
  .hero-inner { max-width: 1200px; margin: 0 auto; }
  .hero .kicker { color: var(--accent2); font-weight: 800; font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; }
  .hero h1 { font-size: clamp(72px, 14vw, 190px); line-height: 0.92; margin: 16px 0 20px; }
  .hero h1 em { color: var(--accent); font-style: normal; }
  .hero-sub { font-size: clamp(17px, 2vw, 22px); max-width: 560px; color: var(--text); }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin: 32px 0; }
  .hero-player { max-width: 560px; margin-top: 8px; }
  .hero-audio { width: 100%; accent-color: var(--accent); }
  .hero-player-note { font-size: 13px; display: flex; align-items: center; gap: 8px; margin-top: 10px; }
  .live-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); display: inline-block; animation: pulse 1.2s infinite; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .card {
    background: var(--bg2); border: 1px solid var(--line); border-top: 4px solid var(--accent);
    padding: 28px; display: flex; flex-direction: column; gap: 12px;
  }
  .card:hover { border-color: var(--accent); }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .card-tag { background: var(--accent); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 10px; border-radius: 3px; }
  .card-date { font-size: 12px; color: var(--muted); }
  .card h3 { font-size: 21px; line-height: 1.25; text-transform: none; letter-spacing: 0; margin: 0; }
  .card p { font-size: 14px; margin: 0; }

  .schedule { border-top: 1px solid var(--line); }
  .show-row { display: grid; grid-template-columns: 220px 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .show-row:hover { background: var(--bg2); }
  .show-time { font-weight: 800; color: var(--accent2); font-size: 14px; letter-spacing: 0.06em; }
  .show-row h3 { font-size: 22px; margin: 0 0 4px; }
  .show-row p { margin: 0; font-size: 14px; }

  .tsr-cta { background: linear-gradient(120deg, #e63900, #ff6a00); padding: clamp(64px, 9vw, 110px) clamp(16px, 4vw, 48px); }
  .tsr-inner { max-width: 1200px; margin: 0 auto; }
  .tsr-cta .kicker { color: #fff; font-weight: 800; font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; opacity: .85; }
  .tsr-cta h2 { font-size: clamp(40px, 7vw, 88px); color: #fff; margin: 14px 0 18px; }
  .tsr-cta h2 em { font-style: normal; text-decoration: underline; text-decoration-thickness: 6px; text-underline-offset: 10px; }
  .tsr-cta p { color: #fff; max-width: 620px; font-size: 17px; }
  .tsr-cta .btn { background: #111; }
  .tsr-cta .btn:hover { background: #000; }
  .tsr-cta .btn.ghost { border-color: rgba(255,255,255,.5); color: #fff; }
  .tsr-cta .btn.ghost:hover { border-color: #fff; }

  @media (max-width: 820px) {
    .cards { grid-template-columns: 1fr; }
    .show-row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>

---
import ElevatedSecurityBadge from '../components/ElevatedSecurityBadge.astro';

import { STREAM_URL, STATION_NAME, TIME_SHARE_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = '95.7 The Boss FM', description = "95.7 The Boss — the city's #1 for hip-hop and R&B. Listen live, catch the latest shows, and stay locked in." } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => (path === '/' ? currentPath === '/' : currentPath.startsWith(path)) ? 'active' : '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#111111" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="95.7 The Boss home">
      <img src="/images/logo.png" alt="95.7 The Boss" width="120" height="120" class="brand-logo" />
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="/" class={isActive('/')}>Home</a>
      <a href="/news/" class={isActive('/news')}>News</a>
      <a href="/shows/" class={isActive('/shows')}>Shows</a>
      <a href="/about/" class={isActive('/about')}>About</a>
      <a href="/contact/" class={isActive('/contact')}>Contact</a>
    </nav>
    <button class="listen-btn" data-action="play" aria-label="Listen live">
      <span class="pulse" aria-hidden="true"></span> LISTEN LIVE
    </button>
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="freq">95.7</span>
        <span class="name">THE BOSS</span>
        <p>The city's #1 for hip-hop and R&amp;B.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/">Home</a>
        <a href="/news/">News</a>
        <a href="/shows/">Shows</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="footer-tsr">
        <p>Powered by</p>
        <a href={TIME_SHARE_URL} target="_blank" rel="noopener">Time Share Radio</a>
        <p class="footer-tsr-note">Independent artists: get your music on the air.</p>
      </div>
    </div>
    <p class="copyright">© {new Date().getFullYear()} 95.7 The Boss FM. All rights reserved.</p>
  <ElevatedSecurityBadge />
</footer>

  <!-- Sticky bottom audio player -->
  <div class="player-bar" id="player-bar" role="region" aria-label="Live radio player">
    <button class="player-toggle" data-action="play" aria-label="Play live stream">
      <svg class="icon-play" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    </button>
    <div class="player-meta">
      <span class="live-badge"><span class="live-dot"></span>LIVE</span>
      <span class="player-station">{STATION_NAME} — Hip-Hop &amp; R&amp;B</span>
    </div>
    <div class="player-volume">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg>
      <input type="range" id="volume" min="0" max="1" step="0.05" value="0.8" aria-label="Volume" />
    </div>
    <audio id="live-audio" preload="none" src={STREAM_URL}></audio>
  </div>

  <script define:vars={{ STREAM_URL }}>
    const audio = document.getElementById('live-audio');
    const playBtns = document.querySelectorAll('[data-action="play"]');
    const playerBar = document.getElementById('player-bar');
    const volume = document.getElementById('volume');
    let playing = false;

    function setPlaying(state) {
      playing = state;
      document.body.classList.toggle('is-playing', state);
      playBtns.forEach(b => b.setAttribute('aria-pressed', String(state)));
    }

    async function toggle() {
      if (!audio) return;
      if (playing) { audio.pause(); setPlaying(false); return; }
      try {
        audio.src = STREAM_URL; // fresh connection each play
        await audio.play();
        setPlaying(true);
      } catch (e) { setPlaying(false); }
    }

    playBtns.forEach(b => b.addEventListener('click', toggle));
    if (audio && volume) {
      audio.volume = parseFloat(volume.value);
      volume.addEventListener('input', () => { audio.volume = parseFloat(volume.value); });
      audio.addEventListener('pause', () => setPlaying(false));
      audio.addEventListener('error', () => setPlaying(false));
    }

    // Mobile menu
    const menuBtn = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.main-nav');
    menuBtn?.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(open));
    });
  </script>

  <style>
    :root {
      --bg: #111111;
      --bg2: #1a1a1a;
      --bg3: #242424;
      --accent: #e63900;
      --accent2: #ff6a00;
      --text: #f5f5f5;
      --muted: #a8a8a8;
      --line: rgba(255,255,255,.12);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font-family: 'Segoe UI', system-ui, -apple-system, Arial, sans-serif;
      padding-bottom: 76px; /* room for sticky player */
    }
    h1, h2, h3 { font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; margin: 0 0 16px; text-transform: uppercase; }
    p { line-height: 1.65; color: var(--muted); }
    a { color: inherit; }

    /* Header */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; gap: 28px;
      padding: 0 clamp(16px, 4vw, 48px); height: 72px;
      background: rgba(17,17,17,.96); backdrop-filter: blur(8px);
      border-bottom: 2px solid var(--accent);
    }
    .brand { display: flex; align-items: baseline; gap: 10px; text-decoration: none; }
    .brand .freq {
      font-size: 30px; font-weight: 900; color: var(--accent);
      font-style: italic; letter-spacing: -0.03em;
    }
    .brand .name { font-size: 22px; font-weight: 800; letter-spacing: 0.06em; }
    .main-nav { display: flex; gap: 26px; margin-left: auto; }
    .main-nav a {
      text-decoration: none; font-weight: 700; font-size: 13px;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
      padding: 6px 2px; border-bottom: 2px solid transparent;
    }
    .main-nav a:hover { color: var(--text); }
    .main-nav a.active { color: var(--text); border-bottom-color: var(--accent); }
    .listen-btn {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--accent); color: #fff; border: 0; cursor: pointer;
      font-weight: 800; font-size: 13px; letter-spacing: 0.1em;
      padding: 12px 20px; border-radius: 4px; text-transform: uppercase;
    }
    .listen-btn:hover { background: var(--accent2); }
    .pulse { width: 10px; height: 10px; border-radius: 50%; background: #fff; animation: pulse 1.6s infinite; }
    @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1);} 50% { opacity: .4; transform: scale(.8);} }
    .menu-toggle { display: none; background: none; border: 0; color: var(--text); font-size: 24px; cursor: pointer; }

    /* Footer */
    .site-footer { border-top: 2px solid var(--accent); background: var(--bg2); margin-top: 80px; }
    .footer-inner {
      display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 40px;
      padding: 56px clamp(16px, 4vw, 48px) 32px; max-width: 1200px; margin: 0 auto;
    }
    .footer-brand .freq { font-size: 34px; font-weight: 900; color: var(--accent); font-style: italic; }
    .footer-brand .name { font-size: 24px; font-weight: 800; letter-spacing: 0.06em; margin-left: 10px; }
    .footer-nav { display: flex; flex-direction: column; gap: 10px; }
    .footer-nav a { text-decoration: none; color: var(--muted); font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
    .footer-nav a:hover { color: var(--accent2); }
    .footer-tsr p { margin: 0 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; }
    .footer-tsr a { font-size: 20px; font-weight: 800; color: var(--accent2); text-decoration: none; }
    .footer-tsr a:hover { text-decoration: underline; }
    .footer-tsr-note { font-size: 13px !important; text-transform: none !important; letter-spacing: 0 !important; margin-top: 8px !important; }
    .copyright { text-align: center; padding: 20px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); margin: 0; }

    /* Sticky player */
    .player-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      display: flex; align-items: center; gap: 16px;
      background: #0a0a0a; border-top: 2px solid var(--accent);
      padding: 12px clamp(16px, 4vw, 48px);
    }
    .player-toggle {
      width: 52px; height: 52px; border-radius: 50%; border: 0; cursor: pointer;
      background: var(--accent); color: #fff; display: grid; place-items: center; flex-shrink: 0;
    }
    .player-toggle:hover { background: var(--accent2); }
    .icon-pause { display: none; }
    body.is-playing .icon-pause { display: block; }
    body.is-playing .icon-play { display: none; }
    .player-meta { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .live-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--accent); color: #fff; font-size: 11px; font-weight: 800;
      letter-spacing: 0.14em; padding: 5px 10px; border-radius: 3px;
    }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #fff; animation: pulse 1.2s infinite; }
    .player-station { font-weight: 700; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .player-volume { display: flex; align-items: center; gap: 8px; margin-left: auto; color: var(--muted); }
    .player-volume input[type="range"] { accent-color: var(--accent); width: 100px; }

    /* Shared page bits */
    .page-hero { padding: clamp(48px, 8vw, 96px) clamp(16px, 4vw, 48px); max-width: 1200px; margin: 0 auto; }
    .page-hero .kicker { color: var(--accent2); font-weight: 800; font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; }
    .page-hero h1 { font-size: clamp(44px, 8vw, 96px); margin: 12px 0 16px; }
    .page-hero h1 em { color: var(--accent); font-style: normal; }
    .btn {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--accent); color: #fff; text-decoration: none; border: 0; cursor: pointer;
      font-weight: 800; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase;
      padding: 16px 28px; border-radius: 4px;
    }
    .btn:hover { background: var(--accent2); }
    .btn.ghost { background: transparent; border: 2px solid var(--line); }
    .btn.ghost:hover { border-color: var(--accent); }
    .section { padding: 0 clamp(16px, 4vw, 48px); max-width: 1200px; margin: 0 auto 72px; }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 28px; border-bottom: 2px solid var(--line); padding-bottom: 14px; }
    .section-head h2 { font-size: clamp(28px, 4vw, 44px); margin: 0; }
    .section-head h2 em { color: var(--accent); font-style: normal; }
    .section-head a { color: var(--accent2); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none; }

    @media (max-width: 820px) {
      .main-nav {
        display: none; position: absolute; top: 72px; left: 0; right: 0;
        background: var(--bg2); flex-direction: column; padding: 16px 24px 24px; gap: 4px;
        border-bottom: 2px solid var(--accent);
      }
      .main-nav.open { display: flex; }
      .main-nav a { padding: 12px 0; border-bottom: 1px solid var(--line); }
      .menu-toggle { display: block; margin-left: auto; }
      .listen-btn { margin-left: 0; }
      .site-header { gap: 16px; }
      .footer-inner { grid-template-columns: 1fr; gap: 28px; }
      .player-volume input[type="range"] { width: 64px; }
      .player-station { display: none; }
    }
  </style>
</body>
</html>
